            <!-- Cases: 0.6x0.6 and 0.6x1.2 (meters). We'll make them 0.9m tall. -->
            <!-- Box size is half-size: (0.3, 0.3, 0.45) for 0.6x0.6x0.9 -->
            <!-- and (0.3, 0.6, 0.45) for 0.6x1.2x0.9 -->

            <!-- ============ ROBOT (triangle-ish base, planar joints) ============ -->
            <body name="robot" pos="5 5 0.06">
                  <!-- Planar movement: x, y, yaw -->
                  <joint name="robot_x" type="slide" axis="1 0 0" damping="100"/>
                  <joint name="robot_y" type="slide" axis="0 1 0" damping="100"/>
                  <joint name="robot_yaw" type="hinge" axis="0 0 1" damping="1"/>

                  <!-- Main footprint: use a cylinder for stable collision (fast + robust).
           Radius ~0.20m (40cm diameter). Height 0.12m. -->
                  <geom name="robot_base" type="cylinder" size="0.20 0.06" mass="20" friction="0.2 0.01 0.001" rgba="0.85 0.85 0.85 1"/>

                  <!-- Nose: small box in front to show orientation (front/back) -->
                  <geom name="robot_nose" type="box" pos="0.18 0 0.03" size="0.03 0.06 0.03" rgba="0.95 0.25 0.25 1" contype="0" conaffinity="0"/>

                  <!-- Visual-only speaking halo (shown via env control when robot is speaking). -->
                  <geom name="robot_speaking_halo" type="cylinder" pos="0 0 -0.055" size="0.34 0.004" rgba="1.0 0.9 0.2 0.0" contype="0" conaffinity="0"/>

                  <!-- Optional: a site for easy tracking (goal distances, etc.) -->
                  <site name="robot_site" pos="0 0 0.06" size="0.02" rgba="1 0 0 1"/>

                  <!-- Speaking text label site (shown via mjLABEL_SITE when speaker is active). -->
                  <site name="explanation" pos="0 0 0.72" size="0.005" rgba="1 1 1 1" group="3"/>

                  <!-- Sad-state follow-me label site (shown when robot emotion is sad). -->
                  <site name="Please_follow_me" pos="0 0 0.78" size="0.005" rgba="1 1 1 1" group="4"/>

                  <!-- Fear-state keep-distance label site (shown when robot emotion is fear). -->
                  <site name="I_need_more_space" pos="0 0 0.84" size="0.005" rgba="1 1 1 1" group="5"/>
            </body>

            <!-- ============ PERSON (oval torso + head + nose, planar joints) ============ -->
            <body name="person1" pos="0 0 0.125">
                  <!-- Planar movement: x, y, yaw -->
                  <joint name="person1_x" type="slide" axis="1 0 0" damping="100" frictionloss="20"/>
                  <joint name="person1_y" type="slide" axis="0 1 0" damping="100" frictionloss="20"/>
                  <joint name="person1_yaw" type="hinge" axis="0 0 1" damping="0.1"/>

                  <!-- Torso as a capsule.
                  shoulders: 0.45m, chest: 0.25m.
                  Capsule 'size' = radius, half-length (along its axis).
                  Align the capsule along Y to represent shoulder width approx 0.45:
                        - radius ~0.125
                        - half-length ~0.10
                  Height: ~0.18m (stands above floor a little). -->
                  <geom name="person1_torso" type="capsule" pos="0 0 0.125" size="0.125 0.10" mass="60" euler="0 0 90" rgba="0.25 0.75 0.35 1"/>

                  <!-- Head -->
                  <geom name="person1_head" type="sphere" pos="0 0 0.36" size="0.09" rgba="0.95 0.85 0.75 1" contype="0" conaffinity="0"/>

                  <!-- Nose: small marker to show front direction (person faces +y in its local frame) -->
                  <geom name="person1_nose" type="box" pos="0.18 0 0.36" size="0.02 0.03 0.02" rgba="0.95 0.35 0.35 1" contype="0" conaffinity="0"/>

                  <!-- Tracking site -->
